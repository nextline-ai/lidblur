    },
    "About": {
      "shouldTranslate": false
    },
    "After turning on LidBlur in Settings, you may need to relaunch it for the change to take effect.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After turning on LidBlur in Settings, you may need to relaunch it for the change to take effect."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 LidBlur를 켠 뒤, 바뀐 권한을 적용하려면 다시 시작이 필요할 수 있습니다."
          }
        }
      }
    },
    "Allow Permission": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Permission"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한 허용하기"
          }
        }
      }
    },
    "Allowed. LidBlur can draw the screen blurred.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowed. LidBlur can draw the screen blurred."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용됨. 화면 내용을 흐리게 그릴 수 있습니다."
          }
        }
      }
    },
    "Appears in the menu bar every time you start your Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appears in the menu bar every time you start your Mac."
